++++    idempotencyApi(ctx).invalidate('create_order', { orderId: 'a' }) // 补偿流程：失效缓存
++++    const r2 = await executeTool(ctx, 'create_order', { orderId: 'a' })
++++    expect(r2).toMatchObject({ isError: false, content: [{ type: 'text', text: 'status=compensated-new' }] })
