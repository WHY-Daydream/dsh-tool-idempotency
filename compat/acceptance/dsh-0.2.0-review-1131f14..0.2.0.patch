++++case_('并发同 key 不同参数 → mismatch，冲突方副作用为零', async () => {
++++  let attempts = 0
++++  const gate = deferred()
++++  const ctx = await boot({ rules: [{ tool: 'create_order', keyArg: 'requestId' }] })
++++  register(ctx, 'create_order', async () => { attempts += 1; return gate.promise })
