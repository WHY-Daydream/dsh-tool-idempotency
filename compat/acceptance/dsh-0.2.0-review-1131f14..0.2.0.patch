+++++    const retry = await executeTool(ctx, 'send_email', { to: 'a@x' })
+++++    expect(retry).toMatchObject({ isError: true, error: { info: { code: 'IDEMPOTENCY_STATE_UNKNOWN' } } })
+++++    expect(attempts).toBe(1)
+++++  })
