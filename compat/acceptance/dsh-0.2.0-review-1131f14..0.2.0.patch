+++++
+++++  it('缓存压力不淘汰执行锁：maxEntries=1 时并发 A 执行锁在 B 写入后仍存活（重试 join）', async () => {
+++++    let attempts = 0
+++++    const gate = deferred<ContentBlock[]>()
