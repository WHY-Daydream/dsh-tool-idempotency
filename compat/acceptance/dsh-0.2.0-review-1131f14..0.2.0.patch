++++let calls = 0
++++ctx.tools.register(defineContentToolFixture({
++++  name: 'create_order',
++++  description: 'create an order',
++++  parameters: {},
++++  async execute() {
++++    calls += 1
++++    return [{ type: 'text', text: `order-${calls}` }]
++++  },
++++}))
