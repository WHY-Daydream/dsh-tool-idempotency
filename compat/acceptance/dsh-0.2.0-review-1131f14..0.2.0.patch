++    maxEntries: MAX_ENTRIES,
++    maxUnknown: MAX_UNKNOWN,
++    maxInFlight: MAX_IN_FLIGHT,
++    ttl: 3600,
++  })
++}
++
++function register(name, body) {
++  ctx.tools.register(defineContentToolFixture({
++    name,
++    description: name,
++    parameters: {},
++    async execute() { return await body() },
++  }))
++}
