+++++    expect(rOwner).toMatchObject({ isError: false, content: [{ type: 'text', text: 'order-1' }] })
+++++    expect(rJoiner).toMatchObject({ isError: false, content: [{ type: 'text', text: 'order-1' }] })
+++++  })
+++++})
