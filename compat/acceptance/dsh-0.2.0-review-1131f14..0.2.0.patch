+++++      await until(() => attempts === round + 1) // started
+++++      const waiterCtrls = Array.from({ length: 50 }, () => new AbortController())
+++++      const waiters = waiterCtrls.map((c) => executeTool(ctx, 'create_order', { orderId: `r${round}` }, c.signal))
+++++      await tick(20) // joined
