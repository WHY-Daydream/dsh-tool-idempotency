+++++    idempotencyApi(ctx).invalidate('create_order', { orderId: 'a' }) // 失效通知后到
+++++    expect(idempotencyApi(ctx).query('create_order', { orderId: 'a' })).toBeUndefined() // 缓存已清除
+++++    await owner
