+++++    registerTool(ctx, 'create_order', async () => {
+++++      attemptsA += 1
+++++      calls.push('create_order')
+++++      return [{ type: 'text', text: 'created-1' }]
+++++    })
+++++    registerTool(ctx, 'ship_order', async () => {
+++++      attemptsB += 1
