+++++    const outcome = await Promise.race([
+++++      waiter.then(
+++++        () => 'resolve' as const,
+++++        () => 'reject' as const,
+++++      ),
+++++      new Promise<never>((_, reject) => setTimeout(() => reject(new Error('waiter hung after abort')), 300)),
