+++  await ctx.plugin(SystemPrompt)
+++  await ctx.plugin(ToolRuntime)
+++  if (order === 'bulkhead-first') {
+++    await ctx.plugin(Bulkhead, BH_SINGLE)
+++    await ctx.plugin(Idempotency, { rules: [{ tool: 'create_order' }] })
+++  } else {
+++    await ctx.plugin(Idempotency, { rules: [{ tool: 'create_order' }] })
+++    await ctx.plugin(Bulkhead, BH_SINGLE)
+++  }
+++  return ctx
+++}
