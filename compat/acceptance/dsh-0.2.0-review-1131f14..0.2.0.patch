+++++
+++++case_('isError 失败（无提交证据）→ unknown：重试被阻止，release 对账后重新执行（0.2.0 契约）', async () => {
+++++  let attempts = 0
+++++  const ctx = await boot({ rules: [{ tool: 'create_order' }] })
+++++  register(ctx, 'create_order', async () => {
