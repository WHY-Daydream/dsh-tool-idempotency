+++  })
+++})
+++
+++describe('0.2.0 Saga 缓存失效：invalidate + 代次', () => {
+++  it('invalidate 清除 succeeded 缓存：同 key 重试重新执行，观察到新业务状态', async () => {
+++    let attempts = 0
+++    const ctx = await toolHarness({ rules: [{ tool: 'create_order' }] })
+++    registerTool(ctx, 'create_order', async () => {
