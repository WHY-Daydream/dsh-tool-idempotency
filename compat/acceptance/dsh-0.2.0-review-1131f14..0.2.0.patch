+++++    const [ra1, ra2] = await Promise.all([a1, a2])
+++++    expect(attempts).toBe(1)
+++++    expect(ra1).toMatchObject({ content: [{ type: 'text', text: 'order-1' }] })
+++++    expect(ra2).toMatchObject({ content: [{ type: 'text', text: 'order-1' }] })
+++++  })
+++++})
+++++
+++++describe('缓存边界：大结果', () => {
