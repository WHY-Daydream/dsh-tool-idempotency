+++++      await executeTool(ctx, 'create_order', { orderId: `k${i}` }) // 重复 → 重放
+++++    }
+++++    const plugMs = performance.now() - t1
+++++    console.log(
+++++      `[STRESS] 基线(200 独立) ${baseMs.toFixed(1)}ms | 插件(100 执行+100 重放) ${plugMs.toFixed(1)}ms | 真实执行=${attempts}`,
