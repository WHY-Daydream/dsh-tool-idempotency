+++++  })
+++++
+++++  it('代次保护：invalidate 后旧 owner 晚到结算不写回缓存（陈旧结果防回写）', async () => {
+++++    let attempts = 0
+++++    const gate = deferred<ContentBlock[]>()
+++++    const ctx = await toolHarness({ rules: [{ tool: 'create_order' }] })
