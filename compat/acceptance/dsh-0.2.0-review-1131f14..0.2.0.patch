+++    const { ctx, dispose } = await lifecycleHarness({ rules: [{ tool: 'create_order' }] })
+++    registerTool(ctx, 'create_order', async () => {
+++      attempts += 1
+++      records.push(`exec-${attempts}`)
+++      return [{ type: 'text', text: `order-${attempts}` }]
