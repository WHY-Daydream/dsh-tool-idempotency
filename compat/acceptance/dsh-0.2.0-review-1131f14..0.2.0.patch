+++++    const r1 = await withinGuard(executeTool(ctx, 'create_order', { orderId: 'a' }), 'first call')
+++++    expect(r1).toMatchObject({ isError: true }) // 超时错误（无提交证据）
+++++    // 0.2.0：超时（响应丢失）→ unknown → 重试被阻止（K1 修复：不再盲目重执行）
