++++  it('重复卸载幂等：dispose 两次无异常', async () => {
++++    const { dispose } = await lifecycleHarness({ rules: [{ tool: 'create_order' }] })
++++    await dispose()
++++    await dispose() // 二次卸载不得抛错
++++  })
++++})
