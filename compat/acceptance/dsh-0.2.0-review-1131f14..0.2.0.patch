+++++ * 不依赖固定 sleep 假设。每个用例同时断言：副作用次数、返回结果、幂等状态、调用记录。
+++++ */
+++++
+++++import { describe, expect, it } from 'vitest'
+++++import type { ContentBlock } from '@deepseek-ai/dsh-llm'
