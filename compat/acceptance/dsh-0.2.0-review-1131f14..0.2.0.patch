+++++  // 下游对账确认副作用确实已提交 → confirm 写入验证结果（完整物化形状）
+++++  api.confirm('create_order', { orderId: 'o1' }, {
+++++    isError: false,
+++++    content: [{ type: 'text', text: 'verified-committed' }],
