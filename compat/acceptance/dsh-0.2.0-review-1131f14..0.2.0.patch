+++++
+++++/** 单槽 + 单排队位 + 满则拒：rule 只声明 `tool`（bulkhead 校验：`tool` 或 `domain+tools` 二选一）。 */
+++++const BH_SINGLE = {
+++++  defaults: { maxConcurrent: 1, maxQueue: 1, queueTimeout: 1000, rejectWhenFull: true },
