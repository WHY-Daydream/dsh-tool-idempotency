+++++    registerTool(ctx, 'create_order', async () => {
+++++      attempts += 1
+++++      if (attempts === 1) return gate.promise // A：挂起占用执行锁
+++++      return [{ type: 'text', text: `order-${attempts}` }] // B 及之后立即完成
+++++    })
