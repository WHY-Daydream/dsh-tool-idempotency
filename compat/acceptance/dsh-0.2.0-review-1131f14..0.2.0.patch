+++++    const replay = await executeTool(ctx, 'create_order', { orderId: 'a' })
+++++    expect(replay).toMatchObject({ isError: false, content: [{ type: 'text', text: 'verified-committed' }] })
+++++    expect(attempts).toBe(1) // 重放确认结果，不重新执行
+++++  })
+++++})
